---
import Base from "../layouts/Base.astro";
import { profile } from "../data/site";
---
<Base title="Resume">
  <div class="page-head"><span class="eyebrow">Resume</span><h2>Resume at a glance</h2></div>
  <div class="resume">
    <div class="paper">
      <div><h4>Experience</h4></div>
      <div class="row"><b>GTM Intern · Recrivio (B2B SaaS)</b><span>Jul 2026 – Present</span></div>
      <div class="row"><b>Project Manager Intern · Medoc Life</b><span>Dec 2024 – Mar 2025</span></div>
      <div><h4>Projects</h4></div>
      <div class="row"><b>Samjho · AI explainer for official documents</b><span>Nov 2026</span></div>
      <div class="row"><b>Smart Email Assistant · AI-powered product</b><span>2026</span></div>
      <div class="row"><b>BorrowBox · peer-to-peer lending platform</b><span>2025</span></div>
      <div><h4>Leadership &amp; outreach</h4></div>
      <div class="row"><b>Chairperson · IEEE-CIET Student Branch</b><span>2025 – 2026</span></div>
      <div><h4>Education</h4></div>
      <div class="row"><b>B.E. CSE · Chitkara University · CGPA 8.25</b><span>Expected May 2027</span></div>
      <div><h4>Core skills</h4></div>
      <p style="color:var(--muted)">User research, requirement gathering, prioritisation, Agile/Scrum, market segmentation, metrics &amp; KPIs, AI evaluation, prompt engineering, data analysis, SQL, Excel, Python, Java, React, Node.js, Spring Boot</p>
    </div>
    <div class="card" style="align-self:start"><span class="eyebrow">Full resume</span><h3>Khushleen Kaur Sekhon · PDF</h3><p>One page, updated November 2026.</p>
      <div class="ctas" style="margin-top:6px"><a class="btn primary" href={profile.resume} download>Download</a><a class="btn" href={profile.resume} target="_blank" rel="noopener">View</a></div></div>
  </div>
  <object data={profile.resume} type="application/pdf" class="pdf" aria-label="Resume PDF">
    <p>Your browser can't show the PDF here. <a href={profile.resume}>Open the resume</a>.</p>
  </object>
</Base>
