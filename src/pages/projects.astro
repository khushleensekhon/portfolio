---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/site";
---
<Base title="Projects">
  <div class="page-head"><span class="eyebrow">Projects</span><h2>Products I've built</h2><p>Each one started with a user problem. I owned them from research and requirements to launch.</p></div>
  <div class="grid g2">{projects.map((p) => <ProjectCard p={p} detailed />)}</div>
</Base>
