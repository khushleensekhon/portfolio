---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/site";
---
<Base title="Projects">
  <div class="page-head"><span class="eyebrow">Projects</span><h2>Products I've built</h2><p>Full-stack builds where I owned the product from requirements to deployment.</p></div>
  <div class="grid g3">{projects.map((p) => <ProjectCard p={p} />)}</div>
</Base>
