---
import Base from "../layouts/Base.astro";
import { gallery } from "../data/site";
// To add photos: put them in public/images/gallery and replace a placeholder with
// <img src="/images/gallery/your-photo.jpg" alt="What the photo shows">
---
<Base title="Gallery">
  <div class="page-head"><span class="eyebrow">Gallery</span><h2>Moments beyond the résumé</h2><p>Hackathons, events and moments from the IEEE-CIET years.</p></div>
  <div class="gallery">{gallery.map((g) => <div class="ph">{g}</div>)}</div>
</Base>
