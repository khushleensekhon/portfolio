---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Blog" description="Notes by Khushleen Kaur Sekhon on go-to-market, leadership and building.">
  <div class="page-head"><span class="eyebrow">Blog</span><h2>Notes on GTM, leadership and building</h2><p>What I'm learning in go-to-market, and what three years of running student events taught me.</p></div>
  {posts.length
    ? <div class="grid g2">{posts.map((p) => <PostCard post={p} />)}</div>
    : <p class="empty">No posts yet.</p>}
</Base>
